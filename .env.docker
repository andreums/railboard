# ADMIN_PASSWORD is REQUIRED in production; the backend refuses to start without it.
# Generate a strong one, e.g. `openssl rand -base64 24`.
# The frontend no longer embeds credentials: log in at the admin screen with this
# user/password once the app is running.
ADMIN_PASSWORD=admin123

# Optional: change the admin username (default: admin)
ADMIN_USER=admin

# Set to 1 when the backend is behind the nginx reverse proxy so the brute-force
# lockout keys on the real client IP (X-Forwarded-For). Keep empty/0 if exposing
# the backend directly to avoid IP spoofing.
TRUST_PROXY=1

# Frontend origin allowed by CORS (set to your public URL)
# Includes the Vite dev server (5173) so the local dev flow works too.
CORS_ORIGIN=http://localhost:5173

# Frontend build arg: API base URL
# Leave empty if using nginx reverse proxy (recommended)
# Set to your public URL if exposing backend directly
VITE_API_URL=

# Host port for the frontend (nginx)
HOST_PORT=80
